{
  "id": "addon.epoch",
  "name": "Epoch",
  "version": "0.1.0",
  "author": "KyaniteLabs",
  "category": "tool",
  "sdkVersion": "0.1.0",
  "description": "Epoch's read-only estimation tools — PERT, COCOMO II, Monte Carlo schedule simulation, sprint forecasting, business-day math, time math, and token cost estimation — as a local ResonantOS service wrapping @kyanitelabs/epoch. A pure in-process calculator: no persistence, no telemetry, no feedback writes.",
  "runtimeType": "local-service",
  "surfaces": [],
  "requestedCapabilities": [
    {
      "capability": "network",
      "granted": false,
      "scope": "self",
      "revocationBehavior": "hard-stop"
    }
  ],
  "provenance": {
    "tier": "sideloaded-unverified",
    "verificationState": "unverified",
    "signed": false
  },
  "runtimeIsolation": {
    "boundary": "host-mediated-service",
    "supportsDegradedMode": true,
    "requiresReviewedGrant": true
  },
  "grantPresets": [
    {
      "id": "epoch-estimation-local",
      "label": "Local estimation runs",
      "description": "Allow Epoch to answer estimation requests on its loopback endpoint (127.0.0.1:4891). All computation is in-process; nothing leaves your machine.",
      "grants": [
        {
          "capability": "network",
          "granted": true,
          "scope": "self",
          "revocationBehavior": "hard-stop"
        }
      ]
    }
  ],
  "providerRequirements": {
    "sharedProfiles": [],
    "supportsPrivateCredentials": true
  },
  "systemSlots": [],
  "archiveIntegration": {
    "readScopes": [],
    "intakeWriteScopes": [],
    "canRequestIngest": false,
    "canWriteKnowledgePages": false
  },
  "health": {
    "strategy": "http-json-status"
  },
  "service": {
    "protocol": "http-json",
    "entrypoint": "http://127.0.0.1:4891",
    "healthCommand": "epoch.status"
  },
  "tools": [
    {
      "name": "epoch.status",
      "description": "Report service version, the pinned upstream @kyanitelabs/epoch version, and the list of exposed estimation tools.",
      "requiredCapabilities": ["network"],
      "inputSchema": { "type": "object", "properties": {}, "additionalProperties": false },
      "outputSchema": {
        "type": "object",
        "properties": {
          "ok": { "type": "boolean" },
          "addon": { "type": "string" },
          "version": { "type": "string" },
          "upstream": { "type": "string" },
          "tools": { "type": "array", "items": { "type": "string" } }
        }
      },
      "audit": { "logRequest": true, "logResult": true, "artifactTypes": ["log"] },
      "requiresHumanApproval": false
    },
    {
      "name": "epoch.estimate",
      "description": "Run one read-only estimation tool from @kyanitelabs/epoch (pert_estimate, cocomo_estimate, monte_carlo_schedule, sprint_forecast, add_business_days, count_business_days, time_math, parse_duration, get_current_time, convert_timezone, token_cost_estimate, compare_models) with upstream semantics. Stateless and synchronous; no estimate is recorded anywhere.",
      "requiredCapabilities": ["network"],
      "inputSchema": {
        "type": "object",
        "properties": {
          "tool": {
            "type": "string",
            "enum": [
              "get_current_time",
              "convert_timezone",
              "parse_duration",
              "time_math",
              "add_business_days",
              "count_business_days",
              "pert_estimate",
              "cocomo_estimate",
              "sprint_forecast",
              "monte_carlo_schedule",
              "token_cost_estimate",
              "compare_models"
            ]
          },
          "params": { "type": "object" }
        },
        "required": ["tool"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "ok": { "type": "boolean" },
          "tool": { "type": "string" },
          "data": { "type": ["object", "array", "string", "number", "boolean"], "description": "The upstream tool result; shape depends on the tool (e.g. time_math add_days returns a date string, most others return an object)." },
          "error": { "type": "string" }
        }
      },
      "audit": { "logRequest": true, "logResult": true, "artifactTypes": ["log"] },
      "requiresHumanApproval": false
    }
  ],
  "installHooks": {
    "onInstall": "start-epoch-service"
  },
  "compatibility": {
    "shellVersion": "^0.1.0",
    "platforms": ["macOS", "linux", "windows"]
  }
}
